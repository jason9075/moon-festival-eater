## 5. 關鍵代碼實作範例 (Core Implementation Guide)

以下為使用 **MediaPipe Tasks Vision** 的 JavaScript 核心邏輯結構：

```javascript
import { FaceLandmarker, FilesetResolver } from "@mediapipe/tasks-vision";

let faceLandmarker;
let video = document.getElementById("webcam");
let canvas = document.getElementById("output_canvas");
let ctx = canvas.getContext("2d");

// 1. 初始化 MediaPipe Face Landmarker
async function initMediaPipe() {
  const filesetResolver = await FilesetResolver.forVisionTasks(
    "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@latest/wasm"
  );
  faceLandmarker = await FaceLandmarker.createFromOptions(filesetResolver, {
    baseOptions: {
      modelAssetPath: `https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task`,
      delegate: "GPU"
    },
    runningMode: "VIDEO",
    numFaces: 1
  });
}

// 2. 遊戲主迴圈
function gameLoop() {
  let startTimeMs = performance.now();
  
  // 檢測臉部
  if (video.currentTime !== lastVideoTime) {
    lastVideoTime = video.currentTime;
    const results = faceLandmarker.detectForVideo(video, startTimeMs);
    
    if (results.faceLandmarks.length > 0) {
      const landmarks = results.faceLandmarks[0];
      
      // 取得嘴巴座標 (MediaPipe 傳回 0~1 的正規化座標，需乘以 Canvas 寬高)
      const mouthX = (1 - (landmarks[13].x + landmarks[14].x) / 2) * canvas.width; // 考量鏡像翻轉
      const mouthY = ((landmarks[13].y + landmarks[14].y) / 2) * canvas.height;
      const mouthOpen = isMouthOpen(landmarks);

      // 進行遊戲物品物理更新與碰撞檢測
      updateItemsAndCheckCollision(mouthX, mouthY, mouthOpen);
    }
  }

  renderCanvas();
  requestAnimationFrame(gameLoop);
}

```

